# ==============================================================
# MausamSahayak Telegram Bot — Environment Configuration Template
# ==============================================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# 2. Backend REST API URL (Manas's Data Center / Backend Server)
API_BASE_URL=http://localhost:8000

# 3. Development / Viva Mock Mode
# Set to 'true' for standalone testing without backend/hardware
# Set to 'false' when connecting to Manas's live REST server
MOCK_API=true

# 4. Viva Demo Scenarios (active when MOCK_API=true)
# Options: 'normal', 'red_alert', 'stale_sensor', 'backend_down'
DEMO_SCENARIO=normal

# 5. Alert Polling Interval (in seconds)
ALERT_POLL_S=60

# 6. SQLite Database Path
BOT_DB=bot.db

# 7. SMS Fallback Provider for Critical RED Alerts
# Options: 'dryrun' (default, safe for local testing) or 'twilio'
SMS_PROVIDER=dryrun

# Twilio Credentials (only required if SMS_PROVIDER=twilio)
TWILIO_SID=your_twilio_account_sid
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_FROM=+1234567890
